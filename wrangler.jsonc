{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neuron",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-06",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neuron",
      "database_id": "ec834211-aaea-44ce-8711-432b3421bd29"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_LIMITER",
      "namespace_id": "4101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_REGISTER_LIMITER",
      "namespace_id": "4102",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_DEMO_LIMITER",
      "namespace_id": "4103",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
